# Vercel builds this image and routes all traffic to it.
# Stage 1: compile Main.java
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /src
COPY Main.java .
RUN javac -d /out Main.java

# Stage 2: small runtime image with just the classes and the web page
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /out ./classes
COPY public ./public
ENV PORT=80
EXPOSE 80
CMD ["java", "-XX:+UseSerialGC", "-Xmx512m", "-cp", "classes", "Main"]
